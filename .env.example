# Supabase Configuration (для клиентского приложения)
# Эти переменные используются в браузере, поэтому безопасны для публикации

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Только для локального CLI (npm run db:push). Не VITE_, не коммитить — положите в .env.local
# SUPABASE_DB_PASSWORD=your_database_password

# ⚠️ ВАЖНО: серверные секреты НЕ должны быть во frontend и НЕ должны начинаться с VITE_.
# Их задают как Supabase Secrets:
#   TWILIO_ACCOUNT_SID
#   TWILIO_AUTH_TOKEN
#   TWILIO_PHONE_NUMBER
#   RESEND_API_KEY              — отправка кодов/писем (customer-auth, create-booking)
#   VERIFICATION_EMAIL_FROM     — From для Resend, напр. noreply@yourdomain.com
#   PUBLIC_SITE_URL             — базовый URL сайта для ссылок регистрации (email)
#   VERIFICATION_LOG_CODES=true — только dev: без Resend, «отправка» в логах функции
#   VERIFICATION_PEPPER         — опционально; иначе используется service role key
#   RATE_LIMIT_PEPPER
#   PAYMENT_WEBHOOK_SECRET
#   CARD_CHECKOUT_SECRET
#   PAYPAL_CLIENT_ID
#   PAYPAL_CLIENT_SECRET
#   CARDCOM_TERMINAL_NUMBER     — абонемент техников: номер терминала Cardcom
#   CARDCOM_API_NAME            — абонемент техников: API name Cardcom (LowProfile + GetLpResult)
#   CARDCOM_API_PASSWORD        — абонемент техников: API password Cardcom (возвраты RefundByTransactionId)
# Без трёх CARDCOM_* оплата абонемента недоступна (PAYMENT_UNAVAILABLE), регистрация техников работает.
# SUPABASE_SERVICE_ROLE_KEY Edge Functions получают от платформы автоматически.
# Не добавляйте его в .env клиента.
# Без CARD_CHECKOUT_SECRET способ credit_card не показывается клиенту.
# Без PAYMENT_WEBHOOK_SECRET payment-webhook отвечает 503 и не меняет статус оплаты.
